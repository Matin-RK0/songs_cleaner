<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="@dimen/widget_horizontal_padding"
    android:paddingEnd="@dimen/widget_horizontal_padding"
    android:background="@drawable/widget_background">
    <ImageView
        android:id="@+id/widget_artwork"
        android:layout_width="@dimen/widget_content_size"
        android:layout_height="@dimen/widget_content_size"
        android:layout_gravity="center_vertical"
        android:layout_marginEnd="@dimen/widget_horizontal_padding"
        android:background="@drawable/widget_artwork_background"
        android:clipToOutline="true"
        android:contentDescription="Artwork"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_notif_applogo" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginEnd="@dimen/widget_horizontal_padding"
        android:gravity="center_vertical"
        android:orientation="vertical">
        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="bottom"
            android:text="Songs Cleaner"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/widget_title_max_size"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="@dimen/widget_title_min_size"
            android:autoSizeMaxTextSize="@dimen/widget_title_max_size"
            android:autoSizeStepGranularity="@dimen/widget_text_size_step"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="top"
            android:layout_marginTop="@dimen/widget_text_gap"
            android:text="No song playing"
            android:textColor="#D0D5DB"
            android:textSize="@dimen/widget_artist_max_size"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="@dimen/widget_artist_min_size"
            android:autoSizeMaxTextSize="@dimen/widget_artist_max_size"
            android:autoSizeStepGranularity="@dimen/widget_text_size_step"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageButton
            android:id="@+id/widget_previous"
            android:layout_width="@dimen/widget_content_size"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:contentDescription="Previous"
            android:padding="@dimen/widget_control_padding"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_previous"
            android:tint="#FFFFFFFF" />
        <ImageButton
            android:id="@+id/widget_play_pause"
            android:layout_width="@dimen/widget_content_size"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:contentDescription="Play or pause"
            android:padding="@dimen/widget_play_padding"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_play"
            android:tint="#FFFFFFFF" />
        <ImageButton
            android:id="@+id/widget_next"
            android:layout_width="@dimen/widget_content_size"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:contentDescription="Next"
            android:padding="@dimen/widget_control_padding"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_next"
            android:tint="#FFFFFFFF" />
    </LinearLayout>
</LinearLayout>
